<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PulsovialAgent</RootNamespace>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <!-- Microsoft.NET.Sdk.Web no genera el atributo [SupportedOSPlatform] a nivel ensamblado
         para proyectos Exe, así que el analizador sigue marcando CA1416 aunque este agente
         solo se publique y ejecute en Windows (win-x64). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
